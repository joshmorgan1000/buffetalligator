/** --------------------------------------------------------------------------------------------------------- Buffet Alligator
 * @file alligator.cpp
 * @brief Implementation of the Alligator class.
 */
#include <alligator.hpp>
#include <memory/pressure.hpp>
#include <containers/bitplane.hpp>

namespace buffetalligator {
/** --------------------------------------------------------------------------------------------------------- Next Slice ID
 * @brief Generate the next available slice ID.
 * @return The next available slice ID.
 */
SliceId Alligator::next_id() {
    while (true) {
        uint32_t current = static_cast<uint32_t>(
            next_slice_.fetch_add(1, std::memory_order_relaxed) & ((1 << POOL_BITS) - 1)
        );
        if (!occupancy_->test_and_set(current)) {
            return static_cast<SliceId>(current);
        }
    }
}
/** ------------------------------------------------------------------------------------------- Worker Thread
 * @struct WorkerThread
 * @brief Represents a worker thread within the Alligator class.
 */
struct Alligator::WorkerThread {
    /// @brief Pointer to the task queue from which this worker thread fetches tasks.
    moodycamel::BlockingConcurrentQueue<Task<>>* task_queue;
    /// @brief Pointer to the atomic variable tracking the current number of active threads.
    std::atomic<size_t>* thread_count;
    /// @brief Pointer to the atomic variable tracking the requested number of threads.
    std::atomic<size_t>* requested_thread_count;
    /// @brief Pointer to the array of worker threads.
    std::array<std::atomic<WorkerThread*>, 32>* worker_threads_;
    /// @brief The actual thread object for this worker thread.
    std::thread thread_;
    /// @brief Signal to indicate when the worker thread should stop execution.
    std::atomic<bool>* stop_signal{nullptr};
    /// @brief Local stop signal for the worker thread.
    std::atomic<bool> local_stop{false};
    /** ----------------------------------------------------------------------------- Work Loop
     * @brief The main work loop for the worker thread. Continuously fetches and
     * executes tasks from the task queue until the stop signal is set or the thread
     * is no longer needed.
     */
    void work() {
        thread_count->fetch_add(1, std::memory_order_relaxed);
        while (!stop_signal->load(std::memory_order_acquire) && !local_stop.load(std::memory_order_acquire)) {
            if (thread_count->load(std::memory_order_acquire) >
                requested_thread_count->load(std::memory_order_acquire)
            ) {
                size_t new_thread_count = thread_count->fetch_sub(1, std::memory_order_acquire);
                if (new_thread_count >= requested_thread_count->load(std::memory_order_acquire)) {
                    local_stop.store(true, std::memory_order_release);
                }
                thread_count->fetch_add(1, std::memory_order_release);
            } else if (thread_count->load(std::memory_order_acquire) <
                requested_thread_count->load(std::memory_order_acquire)
            ) {
                size_t new_thread_count = thread_count->fetch_add(1, std::memory_order_acquire);
                if (new_thread_count < requested_thread_count->load(std::memory_order_acquire)) {
                    WorkerThread* new_worker = new WorkerThread(
                        task_queue,
                        thread_count,
                        requested_thread_count,
                        worker_threads_,
                        stop_signal
                    );
                    size_t index = 0;
                    while (true) {
                        WorkerThread* expected = nullptr;
                        if (worker_threads_->at(index).compare_exchange_strong(
                            expected, new_worker, std::memory_order_release, std::memory_order_relaxed)
                        ) {
                            break;
                        }
                        index = (index + 1) % worker_threads_->size();
                    }
                }
            }
            Task<> task;
            size_t current_tasks = task_queue->size_approx();
            if (current_tasks > 3) {
                size_t current_thread_count = thread_count->load(std::memory_order_acquire);
                if (current_thread_count < 32) {
                    size_t desired = current_thread_count + 1;
                    requested_thread_count->compare_exchange_strong(
                        current_thread_count, desired, std::memory_order_acquire, std::memory_order_relaxed
                    );
                }
            } else if (current_tasks == 0 && thread_count->load(std::memory_order_acquire) > 1) {
                size_t current_thread_count = thread_count->load(std::memory_order_acquire);
                size_t desired = current_thread_count - 1;
                requested_thread_count->compare_exchange_strong(
                    current_thread_count, desired, std::memory_order_acquire, std::memory_order_relaxed
                );
            }
            if (task_queue->try_dequeue(task)) {
                task.execute();
            } else {
                std::this_thread::yield();
            }
        }
        thread_count->fetch_sub(1, std::memory_order_relaxed);
    }
    /** ----------------------------------------------------------------------------- Constructor
     * @brief Constructs a new WorkerThread object and starts the thread.
     * @param thread_id The ID of the worker thread.
     * @param task_queue Pointer to the task queue.
     * @param thread_count Pointer to the atomic thread count.
     * @param requested_thread_count Pointer to the atomic requested thread count.
     * @param worker_threads Pointer to the array of worker threads.
     */
    WorkerThread(
        moodycamel::BlockingConcurrentQueue<Task<>>* task_queue,
        std::atomic<size_t>* thread_count,
        std::atomic<size_t>* requested_thread_count,
        std::array<std::atomic<WorkerThread*>, 32>* worker_threads,
        std::atomic<bool>* stop
    ) : task_queue(task_queue)
    , thread_count(thread_count)
    , requested_thread_count(requested_thread_count)
    , worker_threads_(worker_threads)
    , stop_signal(stop)
    , thread_(&WorkerThread::work, this) {}
    /** ----------------------------------------------------------------------------- Destructor
     * @brief Destroys the WorkerThread object and stops the thread.
     */
    ~WorkerThread() = default;
    WorkerThread(const WorkerThread&) = delete;
    WorkerThread& operator=(const WorkerThread&) = delete;
};
/** --------------------------------------------------------------------------------------------------------- Alligator Constructor
 * @brief Constructs a new Alligator object and initializes its resources.
 */
Alligator::Alligator() {
    plates_.resize((1 << POOL_BITS) * sizeof(Placemat::Plate*), false, true, Placemat::HEAP_ALIGNED);
    host_ptrs_.resize((1 << POOL_BITS) * sizeof(HostPtr), false, true, Placemat::HEAP_ALIGNED);
    gpubufs_.resize((1 << POOL_BITS) * sizeof(GPUBuf), false, true, Placemat::HEAP_ALIGNED);
    occupancy_ = std::make_unique<ConcurrentBitplane>((1 << POOL_BITS));
    WorkerThread* worker = new WorkerThread(
        &task_queue_,
        &thread_count_,
        &requested_thread_count_,
        &worker_threads_,
        &stop_signal_
    );
    worker_threads_[0].store(worker, std::memory_order_release);
}
/** --------------------------------------------------------------------------------------------------------- Claim
 * @brief Claims a slice from the occupancy bitplane.
 * @return The ID of the claimed slice.
 */
Placemat::Plate*& Alligator::plate(SliceId slice_id) {
    return *reinterpret_cast<Placemat::Plate**>(plates_.data() + slice_id.id_ * sizeof(Placemat::Plate*));
}
/** --------------------------------------------------------------------------------------------------------- Plate (const)
 * @brief Retrieves the plate associated with the given slice ID.
 * @param slice_id The ID of the slice.
 * @return A pointer to the plate if it exists, nullptr otherwise.
 */
const Placemat::Plate*& Alligator::plate(const SliceId& slice_id) const {
    return const_cast<const Placemat::Plate*&>(
        *reinterpret_cast<const Placemat::Plate* const*>(
            plates_.data() + slice_id.id_ * sizeof(Placemat::Plate*)
        )
    );
}
/** --------------------------------------------------------------------------------------------------------- HostPtr
 * @brief Retrieves the host pointer associated with the given slice ID.
 * @param slice_id The ID of the slice.
 * @return A pointer to the host pointer if it exists, nullptr otherwise.
 */
HostPtr*& Alligator::host_ptr(SliceId slice_id) {
    return *reinterpret_cast<HostPtr**>(host_ptrs_.data() + slice_id.id_ * sizeof(HostPtr));
}
/** --------------------------------------------------------------------------------------------------------- HostPtr (const)
 * @brief Retrieves the host pointer associated with the given slice ID.
 * @param slice_id The ID of the slice.
 * @return A pointer to the host pointer if it exists, nullptr otherwise.
 */
const HostPtr*& Alligator::host_ptr(const SliceId& slice_id) const {
    return const_cast<const HostPtr*&>(
        *reinterpret_cast<const HostPtr* const*>(
            host_ptrs_.data() + slice_id.id_ * sizeof(HostPtr)
        )
    );
}
/** --------------------------------------------------------------------------------------------------------- GPUBuf
 * @brief Retrieves the GPU buffer associated with the given slice ID.
 * @param slice_id The ID of the slice.
 * @return A pointer to the GPU buffer if it exists, nullptr otherwise.
 */
GPUBuf*& Alligator::gpubuf(SliceId slice_id) {
    return *reinterpret_cast<GPUBuf**>(gpubufs_.data() + slice_id.id_ * sizeof(GPUBuf));
}
/** --------------------------------------------------------------------------------------------------------- GPUBuf (const)
 * @brief Retrieves the GPU buffer associated with the given slice ID.
 * @param slice_id The ID of the slice.
 * @return A pointer to the GPU buffer if it exists, nullptr otherwise.
 */
const GPUBuf*& Alligator::gpubuf(const SliceId& slice_id) const {
    return const_cast<const GPUBuf*&>(
        *reinterpret_cast<const GPUBuf* const*>(
            gpubufs_.data() + slice_id.id_ * sizeof(GPUBuf)
        )
    );
}
/** --------------------------------------------------------------------------------------------------------- Destroy
 * @brief Destroys the resources associated with the given slice ID.
 * @param slice_id The ID of the slice.
 */
void Alligator::destroy(SliceId slice_id) {
    Placemat::Plate* p = plate(slice_id);
    delete p;
    plate(slice_id) = nullptr;
    gpubuf(slice_id) = nullptr;
    host_ptr(slice_id) = nullptr;
    if (!occupancy_->test_and_clear(slice_id)) {
        ALLIGATOR_THROW("Went to destroy a slice in a slot and nothing was there!!");
    }
}
/** --------------------------------------------------------------------------------------------------------- Instance
 * @brief Retrieves the singleton instance of the Alligator.
 * @return A reference to the Alligator instance.
 */
Alligator& Alligator::inst() {
    static Alligator instance;
    return instance;
}
/** --------------------------------------------------------------------------------------------------------- Destructor
 * @brief Destroys the Alligator instance and signals it to stop.
 */
Alligator::~Alligator() {
    stop_signal_.store(true, std::memory_order_release);
    requested_thread_count_.store(0, std::memory_order_release);
}
} // namespace buffetalligator
