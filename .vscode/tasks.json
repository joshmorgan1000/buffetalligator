{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Debug",
            "type": "shell",
            "command": "${workspaceFolder}/run_build.sh",
            "args": [
                "--skip-tests",
                "-DBUFFETALLIGATOR_BUILD_TESTS=ON",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "CMake Optimized",
            "type": "shell",
            "command": "${workspaceFolder}/run_build.sh",
            "args": [
                "--skip-tests",
                "-DBUFFETALLIGATOR_BUILD_TESTS=ON",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
