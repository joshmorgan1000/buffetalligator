if(NOT PROJECT_NAME STREQUAL "alligator" OR NOT CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
    return()
endif()
enable_testing()
function(register_slice_map_candidates)
    set(experiment "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    set(generated "${CMAKE_BINARY_DIR}/map-candidates")
    find_program(EXPERIMENT_RUBY ruby REQUIRED)
    foreach(kind IN ITEMS map slice)
        execute_process(COMMAND "${EXPERIMENT_RUBY}" "${experiment}/prepare_${kind}_variants.rb"
            "${generated}" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Could not prepare ${kind} candidates; inspect the generator diagnostic")
        endif()
    endforeach()
    foreach(candidate IN ITEMS baseline deferred_payload_hazard combined_publication_counter map_bookkeeping)
        add_library(candidate_map_${candidate} OBJECT "${generated}/${candidate}/slicemap.cpp")
        set_target_properties(candidate_map_${candidate} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        target_include_directories(candidate_map_${candidate} PRIVATE "${PROJECT_SOURCE_DIR}/src")
        target_link_libraries(candidate_map_${candidate} PRIVATE alligator::alligator)
    endforeach()
    foreach(candidate IN ITEMS baseline fused_metadata_clone)
        add_library(candidate_slice_${candidate} OBJECT "${generated}/slice_${candidate}.cpp")
        set_target_properties(candidate_slice_${candidate} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        target_include_directories(candidate_slice_${candidate} PRIVATE "${PROJECT_SOURCE_DIR}/src")
        target_link_libraries(candidate_slice_${candidate} PRIVATE alligator::alligator)
    endforeach()
    set(checks slice_map_test slice_map_concurrency_test slice_core_regression_test
        global_slice_lifetime_test backend_shader_test)
    foreach(check IN LISTS checks)
        add_library(candidate_check_${check} OBJECT "${PROJECT_SOURCE_DIR}/tests/${check}.cpp")
        target_include_directories(candidate_check_${check} PRIVATE "${PROJECT_SOURCE_DIR}/src")
        target_link_libraries(candidate_check_${check} PRIVATE alligator::alligator)
    endforeach()
    add_library(candidate_benchmark OBJECT "${PROJECT_SOURCE_DIR}/tests/benchmarks/slice_map_benchmark.cpp")
    target_link_libraries(candidate_benchmark PRIVATE alligator::alligator)
    foreach(candidate IN ITEMS baseline deferred_payload_hazard combined_publication_counter
            map_bookkeeping fused_metadata_clone)
        set(map_variant "${candidate}")
        set(slice_variant baseline)
        if(candidate STREQUAL fused_metadata_clone)
            set(map_variant baseline)
            set(slice_variant fused_metadata_clone)
        endif()
        set(objects $<TARGET_OBJECTS:candidate_map_${map_variant}>
            $<TARGET_OBJECTS:candidate_slice_${slice_variant}>)
        add_executable(map_candidate_${candidate} $<TARGET_OBJECTS:candidate_benchmark> ${objects})
        target_link_libraries(map_candidate_${candidate} PRIVATE alligator::alligator)
        foreach(check IN LISTS checks)
            set(target "check_${candidate}_${check}")
            add_executable(${target} $<TARGET_OBJECTS:candidate_check_${check}> ${objects})
            target_link_libraries(${target} PRIVATE alligator::alligator)
            if(NOT check STREQUAL backend_shader_test)
                add_test(NAME ${target} COMMAND ${target})
                set_tests_properties(${target} PROPERTIES TIMEOUT 120
                    ENVIRONMENT "ALLIGATOR_GPU_BACKEND=cpu" LABELS "candidate;cpu")
            endif()
        endforeach()
        file(READ "${PROJECT_SOURCE_DIR}/tests/slice_map_growth_test.cpp" growth_source)
        string(REPLACE "\"../src/containers/slicemap.cpp\""
            "\"${generated}/${map_variant}/slicemap.cpp\"" growth_source "${growth_source}")
        file(WRITE "${generated}/growth_${candidate}.cpp" "${growth_source}")
        set(target "check_${candidate}_growth")
        add_executable(${target} "${generated}/growth_${candidate}.cpp"
            $<TARGET_OBJECTS:candidate_slice_${slice_variant}>)
        target_include_directories(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src" "${PROJECT_SOURCE_DIR}/tests")
        target_link_libraries(${target} PRIVATE alligator::alligator)
        add_test(NAME ${target} COMMAND ${target})
        set_tests_properties(${target} PROPERTIES TIMEOUT 120
            ENVIRONMENT "ALLIGATOR_GPU_BACKEND=cpu" LABELS "candidate;cpu")
        foreach(backend IN ITEMS vulkan metal)
            if(backend STREQUAL metal AND NOT BUFFETALLIGATOR_METAL_ENABLED)
                continue()
            endif()
            set(modes translated)
            if(backend STREQUAL metal)
                list(APPEND modes native)
            endif()
            foreach(mode IN LISTS modes)
                set(test "check_${candidate}_${backend}_${mode}")
                add_test(NAME ${test} COMMAND check_${candidate}_backend_shader_test ${mode})
                set_tests_properties(${test} PROPERTIES TIMEOUT 120 SKIP_RETURN_CODE 77
                    ENVIRONMENT "ALLIGATOR_GPU_BACKEND=${backend};MTL_DEBUG_LAYER=1;MTL_SHADER_VALIDATION=1"
                    LABELS "candidate;gpu")
            endforeach()
        endforeach()
    endforeach()
    message(STATUS "Isolated SliceMap candidates enabled; production sources and archive are unchanged")
endfunction()
cmake_language(DEFER CALL register_slice_map_candidates)
